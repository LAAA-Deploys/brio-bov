{
  "name": "brio-portfolio-bov",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-404.mjs",
    "preview": "vite preview",
    "lint": "eslint src scripts tests",
    "verify": "node scripts/verify-data.mjs && node scripts/qa-copy.mjs && node scripts/qa-assets.mjs",
    "test": "vitest run",
    "qa:visual": "node scripts/run-proof.mjs",
    "qa:all": "npm run lint && npm run verify && npm run test && npm run build && npm run qa:visual"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.13.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
